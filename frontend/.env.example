# Backend API Location (Server-Side Proxy)
BACKEND_URL=http://localhost:8000

# Google OAuth Client ID (Public to browser for Google Sign-In button)
NEXT_PUBLIC_AUTH_GOOGLE_ID=your_google_oauth_client_id.apps.googleusercontent.com

# HMAC Session Signing Secret (Must EXACTLY match AUTH_SECRET in Backend)
AUTH_SECRET=generate_a_random_secret_at_least_32_characters_long
