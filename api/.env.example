# Google Gemini AI (Free tier on Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-2.5-flash

# Fallback Groq AI (Free tier on console.groq.com)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Database (PostgreSQL with pgvector)
DB_URL=postgresql://username:password@localhost:5432/your_database?sslmode=require

# Cache & Rate Limiting (Local Docker Redis or Upstash cloud)
# For local Docker: redis://localhost:6379 (run: docker compose up -d redis)
REDIS_URL=redis://localhost:6379

# Google OAuth & Signed Session Security
AUTH_GOOGLE_ID=your_google_oauth_client_id.apps.googleusercontent.com
AUTH_SECRET=generate_a_random_secret_at_least_32_characters_long

# CORS & Networking
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
WEBHOOK_RATE_LIMIT_PER_MINUTE=50
