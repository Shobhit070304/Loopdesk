# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-2.5-flash

# Database (PostgreSQL with pgvector)
DB_URL=postgresql://username:password@localhost:5432/your_database?sslmode=require

# Cache & Rate Limiting (Redis / Upstash)
REDIS_URL=rediss://default:your_redis_token@your_redis_host.upstash.io:6379

# Google OAuth & Signed Session Security
AUTH_GOOGLE_ID=your_google_oauth_client_id.apps.googleusercontent.com
AUTH_SECRET=generate_a_random_secret_at_least_32_characters_long

# CORS & Networking
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
WEBHOOK_RATE_LIMIT_PER_MINUTE=50
