
GEMINI_API_KEY=your_gemini_api_key_here

DB_URL=postgresql://admin:password@localhost:5433/rag_db
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Optional: Google sub of the one account that should own pre-workspace data.
LEGACY_WORKSPACE_ID=
WEBHOOK_RATE_LIMIT_PER_MINUTE=300
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-2.5-flash
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters_long
AUTH_GOOGLE_ID=your_google_oauth_client_id

